---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
---

<Layout title="Accueil">
  <Hero 
    title="Votre Expert Plombier à <br/>Mouscron"
    subtitle="Intervention rapide, installation de qualité et dépannage 24/7. Faites confiance à VENSOL pour tous vos besoins en plomberie et chauffage."
    primaryCta="Demander un Devis"
    primaryHref="/contact"
    secondaryCta="Nos Services"
    secondaryHref="/services"
  />

  <section class="section">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold">Pourquoi choisir VENSOL ?</h2>
        <p class="text-muted mt-4 max-w-2xl mx-auto">Nous combinons expertise technique et service client exceptionnel pour vous offrir les meilleures solutions de plomberie.</p>
      </div>

      <div class="features-grid">
        <div class="glass-card feature-card">
          <div class="icon-wrapper bg-gradient">
            <span class="text-2xl">⚡</span>
          </div>
          <h3>Intervention Rapide</h3>
          <p class="text-muted">Nous sommes disponibles 24/7 pour les urgences. Nous intervenons rapidement pour limiter les dégâts.</p>
        </div>
        
        <div class="glass-card feature-card">
          <div class="icon-wrapper bg-gradient">
            <span class="text-2xl">🛠️</span>
          </div>
          <h3>Expertise Reconnue</h3>
          <p class="text-muted">Plus de 15 ans d'expérience dans le domaine. Nos plombiers sont qualifiés et certifiés.</p>
        </div>

        <div class="glass-card feature-card">
          <div class="icon-wrapper bg-gradient">
            <span class="text-2xl">✅</span>
          </div>
          <h3>Garantie Qualité</h3>
          <p class="text-muted">Nous utilisons des matériaux de première qualité et garantissons toutes nos interventions.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-surface">
    <div class="container cta-container">
      <div class="cta-content glass-card">
        <h2 class="text-3xl font-bold">Besoin d'une intervention urgente ?</h2>
        <p class="text-lg mt-4 mb-8">Notre équipe est prête à intervenir à Mouscron et ses environs.</p>
        <div class="flex gap-4 justify-center">
          <a href="/contact" class="btn btn-primary">Nous Contacter</a>
          <a href="tel:+32490067245" class="btn btn-outline">Appeler le 0490 06 72 45</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .mb-12 { margin-bottom: 3rem; }
  .mt-4 { margin-top: 1rem; }
  .mb-8 { margin-bottom: 2rem; }
  .mx-auto { margin-left: auto; margin-right: auto; }
  .max-w-2xl { max-width: 42rem; }
  .text-3xl { font-size: 1.875rem; line-height: 1.2; }
  .text-lg { font-size: 1.125rem; }
  .font-bold { font-weight: 700; }
  .flex { display: flex; }
  .gap-4 { gap: 1rem; }
  .justify-center { justify-content: center; }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .feature-card {
    text-align: center;
    padding: 3rem 2rem;
  }

  .icon-wrapper {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem auto;
  }

  .cta-container {
    text-align: center;
  }

  .cta-content {
    padding: 5rem 2rem;
    background: linear-gradient(135deg, rgba(14, 165, 233, 0.05) 0%, rgba(245, 158, 11, 0.05) 100%);
  }
  
  @media (max-width: 576px) {
    .flex { flex-direction: column; }
  }
</style>
