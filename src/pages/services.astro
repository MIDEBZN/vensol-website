---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Nos Services" description="Découvrez nos services de plomberie et chauffage à Mouscron. Installation, entretien et réparation.">
  <div class="page-header bg-surface">
    <div class="container">
      <h1 class="text-4xl font-bold mb-4">Nos <span class="text-gradient">Services</span></h1>
      <p class="text-xl text-muted max-w-3xl">Des solutions complètes pour tous vos besoins en plomberie et chauffage, réalisées avec professionnalisme et expertise.</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="services-grid">
        
        <div class="glass-card service-card">
          <div class="service-icon">🔧</div>
          <h3>Dépannage Plomberie</h3>
          <p class="text-muted mb-4">Fuites d'eau, canalisations bouchées, problèmes de robinetterie. Nous intervenons rapidement pour résoudre vos urgences.</p>
          <ul class="service-list">
            <li>✓ Recherche de fuite</li>
            <li>✓ Débouchage canalisation</li>
            <li>✓ Réparation robinetterie</li>
          </ul>
        </div>

        <div class="glass-card service-card">
          <div class="service-icon">🚿</div>
          <h3>Installation Sanitaire</h3>
          <p class="text-muted mb-4">Création ou rénovation de salle de bain, installation de WC, douches à l'italienne et baignoires.</p>
          <ul class="service-list">
            <li>✓ Rénovation salle de bain</li>
            <li>✓ Pose d'équipements</li>
            <li>✓ Adaptation PMR</li>
          </ul>
        </div>

        <div class="glass-card service-card">
          <div class="service-icon">🔥</div>
          <h3>Chauffage</h3>
          <p class="text-muted mb-4">Installation, entretien et dépannage de vos systèmes de chauffage pour un confort optimal.</p>
          <ul class="service-list">
            <li>✓ Entretien chaudière</li>
            <li>✓ Installation radiateur</li>
            <li>✓ Désembouage</li>
          </ul>
        </div>

        <div class="glass-card service-card">
          <div class="service-icon">💧</div>
          <h3>Traitement de l'eau</h3>
          <p class="text-muted mb-4">Solutions pour améliorer la qualité de votre eau et protéger vos installations contre le calcaire.</p>
          <ul class="service-list">
            <li>✓ Pose d'adoucisseur</li>
            <li>✓ Filtres anti-calcaire</li>
            <li>✓ Entretien annuel</li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <section class="section bg-surface">
    <div class="container text-center">
      <h2 class="text-3xl font-bold mb-6">Un projet spécifique ?</h2>
      <a href="/contact" class="btn btn-primary btn-lg">Demandez un devis sur mesure</a>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    padding: 6rem 0 4rem;
    border-bottom: 1px solid var(--glass-border);
  }
  
  .text-4xl { font-size: 2.5rem; line-height: 1.1; }
  .text-xl { font-size: 1.25rem; }
  .font-bold { font-weight: 700; }
  .mb-4 { margin-bottom: 1rem; }
  .mb-6 { margin-bottom: 1.5rem; }
  .max-w-3xl { max-width: 48rem; }
  
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2.5rem;
  }
  
  .service-card {
    display: flex;
    flex-direction: column;
  }
  
  .service-icon {
    font-size: 3rem;
    margin-bottom: 1.5rem;
  }
  
  .service-card h3 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }
  
  .service-list {
    list-style: none;
    margin-top: auto;
    padding-top: 1.5rem;
    border-top: 1px solid var(--glass-border);
  }
  
  .service-list li {
    margin-bottom: 0.5rem;
    color: var(--text-color);
    font-weight: 500;
  }
  
  @media (max-width: 768px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
