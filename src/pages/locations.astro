---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Zones d'intervention" description="VENSOL intervient à Mouscron et dans toutes les communes environnantes pour vos travaux de plomberie.">
  <div class="page-header bg-surface">
    <div class="container text-center">
      <h1 class="text-4xl font-bold mb-4">Nos <span class="text-gradient">Zones d'Intervention</span></h1>
      <p class="text-xl text-muted max-w-2xl mx-auto">Nous nous déplaçons rapidement à Mouscron et dans toute la région pour répondre à vos besoins.</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="locations-content">
        <div class="glass-card locations-main">
          <div class="locations-header">
            <span class="text-4xl mb-4 block">📍</span>
            <h2 class="text-3xl font-bold">Mouscron (7700)</h2>
            <p class="text-muted mt-2">Notre zone d'intervention principale. Dépannage rapide garanti !</p>
          </div>
          
          <div class="locations-list">
            <h3>Communes voisines (Intervention sous 24h)</h3>
            <ul>
              <li>Dottignies (7711)</li>
              <li>Herseaux (7712)</li>
              <li>Luingne (7700)</li>
              <li>Tourcoing (France)</li>
              <li>Wattrelos (France)</li>
              <li>Estaimpuis (7730)</li>
              <li>Courtrai (Kortrijk)</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    padding: 6rem 0 4rem;
    border-bottom: 1px solid var(--glass-border);
  }
  
  .text-4xl { font-size: 2.5rem; line-height: 1.1; }
  .text-3xl { font-size: 1.875rem; }
  .text-xl { font-size: 1.25rem; }
  .font-bold { font-weight: 700; }
  .mb-4 { margin-bottom: 1rem; }
  .mt-2 { margin-top: 0.5rem; }
  .block { display: block; }
  .mx-auto { margin-left: auto; margin-right: auto; }
  .max-w-2xl { max-width: 42rem; }
  
  .locations-content {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .locations-main {
    padding: 4rem;
    text-align: center;
  }
  
  .locations-header {
    margin-bottom: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--glass-border);
  }
  
  .locations-list h3 {
    margin-bottom: 1.5rem;
    color: var(--primary-color);
  }
  
  .locations-list ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    list-style: none;
    text-align: left;
  }
  
  .locations-list li {
    padding: 1rem;
    background: var(--bg-color);
    border-radius: var(--radius-md);
    border: 1px solid var(--glass-border);
    font-weight: 500;
  }
  
  @media (max-width: 768px) {
    .locations-main {
      padding: 2rem;
    }
  }
</style>
